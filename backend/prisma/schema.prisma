generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Profile {
  id        String   @id
  email     String   @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id           String   @id @default(uuid())
  title        String
  description  String
  image        String
  githubUrl    String?
  liveUrl      String?
  technologies String[]
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
